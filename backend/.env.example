DATABASE_URL=postgresql://usuario:contraseña@host/basededatos
FRONTEND_URL=http://localhost:5173

# Solo para desarrollo: con valor 1 se desactivan los límites de peticiones.
# DESACTIVAR_LIMITES=1

# Cadena de conexión de una base de datos aparte, solo para las pruebas.
# Debe ser distinta a DATABASE_URL: las pruebas crean y borran datos.
DATABASE_URL_PRUEBAS=postgresql://usuario:contraseña@host/basededatos